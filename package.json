{
  "name": "home-guard-door-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:ai-visualizer": "node --import tsx scripts/verifyAiVisualizer.ts",
    "test:ai-visualizer:ui": "node --import tsx scripts/verifyAiVisualizerUi.ts",
    "test:submission": "node --import tsx scripts/verifySubmissionPayload.ts",
    "test:pdf-renderer": "node --import tsx scripts/verifyPdfRenderer.ts",
    "audit:assets": "node --import tsx scripts/auditProductionAssets.ts",
    "optimize:assets": "node --import tsx scripts/optimizeProductionAssets.ts",
    "test:configuration-integrity": "node --import tsx scripts/verifyConfigurationIntegrity.ts",
    "test:configuration-renders": "node --import tsx scripts/verifyConfigurationRenders.ts",
    "lint": "eslint .",
    "generate:hero": "tsx scripts/generateHeroDoorImages.ts"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@vitejs/plugin-react": "^4.3.4",
    "heic2any": "^0.0.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.8"
  }
}
