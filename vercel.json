{
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] },
    { "source": "/:slug([a-z0-9-]+)", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] },
    { "source": "/assets/:file([a-zA-Z0-9_-]+-[a-zA-Z0-9_-]{8}\\.(?:js|css))", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "functions": {
    "api/generate-door-visualization.ts": {
      "includeFiles": "{public/assets/**,server/aiDoorVisualization.ts,src/data/**,src/features/home-visualizer/aiImagePreparation.ts}",
      "maxDuration": 180
    },
    "api/detect-entrance-structure.ts": {
      "includeFiles": "{server/aiDoorVisualization.ts,src/data/**,src/features/home-visualizer/aiImagePreparation.ts,src/features/home-visualizer/entranceFitStrategy.ts}",
      "maxDuration": 60
    }
  }
}
