# Server-only Zapier Catch Hook used by api/submit-door-builder.ts.
# Configure this in Vercel; never expose it as a VITE_ variable.
ZAPIER_DOOR_BUILDER_WEBHOOK_URL=

# Server-only connection to the existing HGI Dealer Portal Supabase project.
# Never expose the service-role key through a VITE_ or other public variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Zapier Catch Hook used by api/submit-feedback.ts.
ZAPIER_FEEDBACK_WEBHOOK_URL=
